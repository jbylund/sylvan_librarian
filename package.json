{
  "name": "sylvan_librarian",
  "version": "1.0.0",
  "description": "An open source Magic: The Gathering card search engine. Unofficial Fan Content permitted under the Wizards of the Coast Fan Content Policy. Not approved/endorsed by Wizards. Card data from Scryfall.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:js": "jest",
    "format": "prettier --write api/static/index.html",
    "format:check": "prettier --check api/static/index.html"
  },
  "jest": {
    "testEnvironment": "jsdom"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbylund/sylvan_librarian.git"
  },
  "keywords": [
    "magic-the-gathering",
    "mtg",
    "card-search",
    "scryfall",
    "open-source"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=26.1.0"
  },
  "bugs": {
    "url": "https://github.com/jbylund/sylvan_librarian/issues"
  },
  "homepage": "https://github.com/jbylund/sylvan_librarian#readme",
  "devDependencies": {
    "cssnano": "^9.0.4",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "prettier": "^3.9.6",
    "terser": "^5.51.2"
  },
  "overrides": {
    "js-yaml": "^5.4.1"
  }
}
